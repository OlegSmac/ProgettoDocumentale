<div class="row g-3 mt-2">
    <div class="col-12 col-lg-4">
        <div class="border rounded p-2 bg-white">            
            <div id="slaHierarchy"></div>
        </div>
    </div>
</div>

<script>
    function loadSlaHierarchy() {
        $.getJSON("/BankOperator/GetSLAReportsWithDateHierarchy", function (items) {

            var html = `
                <ul class="list-unstyled mb-0">
                    <li class="mb-2">
                        <a href="#" class="text-decoration-none text-dark fw-semibold hierarchy-all-filter">
                            <i class="bi bi-list-ul me-2"></i>
                            All SLA reports
                        </a>
                    </li>
                    <li><hr class="my-2"></li>
            `;

            items.forEach(function (y, yi) {
                var yearCollapseId = `sla-year-${yi}`;

                html += `
                    <li class="mb-2">
                        <div class="d-flex align-items-center gap-2">

                            <button type="button"
                                    class="btn btn-link p-0 text-decoration-none fw-semibold text-dark"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#${yearCollapseId}"
                                    aria-expanded="false">
                                <i class="bi bi-plus-square hierarchy-toggle-icon"></i>
                            </button>

                            <div class="text-decoration-none text-dark fw-semibold">${y.Year}</div>
                        </div>

                        <div class="collapse mt-1" id="${yearCollapseId}">
                            <ul class="list-unstyled ps-4 mb-0">
                                ${(y.Months || []).map((m, mi) => {
                                    var monthCollapseId = `sla-month-${yi}-${mi}`;

                                    return `
                                        <li class="mb-1">
                                            <div class="d-flex align-items-center gap-2">

                                                <button type="button"
                                                        class="btn btn-link p-0 text-decoration-none text-dark"
                                                        data-bs-toggle="collapse"
                                                        data-bs-target="#${monthCollapseId}"
                                                        aria-expanded="false">
                                                    <i class="bi bi-plus-square hierarchy-toggle-icon"></i>
                                                </button>

                                                <div class="text-decoration-none text-dark">
                                                    ${m.Month} <span class="text-muted">(${m.Count})</span>
                                                </div>

                                            </div>

                                            <div class="collapse mt-1" id="${monthCollapseId}">
                                                <ul class="list-unstyled ps-4 mb-0">
                                                    ${(m.Reports || []).map(r => `
                                                        <li class="mb-1">
                                                            <div class="text-decoration-none text-dark report-item" data-id="${r.Id}">
                                                                <i class="bi bi-file-earmark-text me-1"></i>
                                                                ${r.Name}
                                                            </div>
                                                        </li>
                                                    `).join('')}
                                                </ul>
                                            </div>
                                        </li>
                                    `;
                                }).join('')}
                            </ul>
                        </div>
                    </li>
                `;
            });

            html += `</ul>`;

            $("#slaHierarchy").html(html);
            bindReportContextMenu("#slaHierarchy .report-item");
        })
        .fail(function () {
            $("#slaHierarchy").html('<div class="text-danger">Failed to load SLA hierarchy</div>');
        });
    }

    loadSlaHierarchy();
</script>
