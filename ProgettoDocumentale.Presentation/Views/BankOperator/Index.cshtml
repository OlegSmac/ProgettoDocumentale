@{
    ViewBag.Title = "Bank operator page";
}

@section styles {
    <link rel="stylesheet" href="~/Content/all.min.css" />
    <link rel="stylesheet" href="~/Content/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/Content/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="~/Content/jquery.contextMenu.min.css" />
    <link rel="stylesheet" href="~/Content/bootstrap-select.min.css" />
}

<div class="container-fluid">
    @Html.AntiForgeryToken()

    <ul class="nav nav-tabs mb-3" id="bankOperatorTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active"
                    id="service-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#serviceTab"
                    data-url="@Url.Action("ServiceReportsTab", "BankOperator")"
                    type="button"
                    role="tab"
                    aria-controls="serviceTab"
                    aria-selected="true">
                Service Reports
            </button>
        </li>

        <li class="nav-item" role="presentation">
            <button class="nav-link"
                    id="sla-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#slaTab"
                    data-url="@Url.Action("SlaReportsTab", "BankOperator")"
                    type="button"
                    role="tab"
                    aria-controls="slaTab"
                    aria-selected="false">
                SLA Reports
            </button>
        </li>

        <li class="nav-item" role="presentation">
            <button class="nav-link"
                    id="projects-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#projectsTab"
                    data-url="@Url.Action("ProjectsReportsTab", "BankOperator")"
                    type="button"
                    role="tab"
                    aria-controls="projectsTab"
                    aria-selected="false">
                Projects
            </button>
        </li>
    </ul>

    <div class="tab-content" id="bankOperatorTabsContent">

        <div class="tab-pane fade show active"
             id="serviceTab"
             role="tabpanel"
             aria-labelledby="service-tab">

            <div class="tab-loader p-2" data-loaded="false">
                <div class="text-muted">Loading…</div>
            </div>

        </div>

        <div class="tab-pane fade"
             id="slaTab"
             role="tabpanel"
             aria-labelledby="sla-tab">

            <div class="tab-loader p-2" data-loaded="false"></div>

        </div>

        <div class="tab-pane fade"
             id="projectsTab"
             role="tabpanel"
             aria-labelledby="projects-tab">

            <div class="tab-loader p-2" data-loaded="false"></div>

        </div>

    </div>
</div>

<div class="modal fade" id="infoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-body" id="infoModalContent"></div>        
    </div>
</div>

<style>
    .dt-center {
        text-align: center;
    }    
</style>

@section scripts {
    <script src="~/Scripts/dataTables.min.js"></script>
    <script src="~/Scripts/jquery.ui.position.min.js"></script>
    <script src="~/Scripts/jquery.contextMenu.min.js"></script>
    <script src="~/Scripts/bootstrap-select.min.js"></script>

    <script src="~/Scripts/BankOperator/bankOperatorHierarchy.js"></script>
    
    <script src="~/Scripts/Modal/openModal.js"></script>

    <script>
        function loadTab(btn) {
            var url = btn.getAttribute("data-url");
            var target = btn.getAttribute("data-bs-target");
            if (!url || !target) return;

            var $loader = $(target).find(".tab-loader");            

            $loader.html('<div class="text-muted">Loading…</div>');
            $loader.load(url);
        }

        $(function () {
            var activeBtn = document.querySelector('#bankOperatorTabs .nav-link.active');
            if (activeBtn) loadTab(activeBtn);
        });

        document.getElementById('bankOperatorTabs')
            .addEventListener('shown.bs.tab', function (event) {
                loadTab(event.target);
            });

    </script>

}
