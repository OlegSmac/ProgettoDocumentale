<div class="row g-3 mt-2">
    <div class="col-12 col-lg-4">
        <div class="border rounded p-2 bg-white">            
            <div id="projectsHierarchy"></div>
        </div>
    </div>
</div>

<script>
    function loadProjectsHierarchy() {
        $.getJSON("/BankOperator/GetProjectsWithDocumentsWithDateHierarchy", function (items) {

            var html = `
                <ul class="list-unstyled mb-0">
                    <li class="mb-2">
                        <a href="#" class="text-decoration-none text-dark fw-semibold hierarchy-all-filter">
                            <i class="bi bi-list-ul me-2"></i>
                            All projects documents
                        </a>
                    </li>
                    <li><hr class="my-2"></li>
            `;

            items.forEach(function (p, pi) {
                var projectCollapseId = `prj-${pi}`;

                html += `
                    <li class="mb-2">
                        <div class="d-flex align-items-center gap-2">

                            <button type="button"
                                    class="btn btn-link p-0 text-decoration-none fw-semibold text-dark"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#${projectCollapseId}"
                                    aria-expanded="false">
                                <i class="bi bi-plus-square hierarchy-toggle-icon"></i>
                            </button>

                            <div class="text-decoration-none text-dark fw-semibold">${p.Project}</div>
                        </div>

                        <div class="collapse mt-1" id="${projectCollapseId}">
                            <ul class="list-unstyled ps-4 mb-0">
                                ${(p.ProjectTypes || []).map((t, ti) => {
                                    var typeCollapseId = `prj-type-${pi}-${ti}`;

                                    return `
                                        <li class="mb-1">
                                            <div class="d-flex align-items-center gap-2">

                                                <button type="button"
                                                        class="btn btn-link p-0 text-decoration-none text-dark"
                                                        data-bs-toggle="collapse"
                                                        data-bs-target="#${typeCollapseId}"
                                                        aria-expanded="false">
                                                    <i class="bi bi-plus-square hierarchy-toggle-icon"></i>
                                                </button>

                                                <div class="text-decoration-none text-dark">
                                                    ${t.Name} <span class="text-muted">(${t.Count})</span>
                                                </div>

                                            </div>

                                            <div class="collapse mt-1" id="${typeCollapseId}">
                                                <ul class="list-unstyled ps-4 mb-0">
                                                    ${(t.Reports || []).map(r => `
                                                        <li class="mb-1">
                                                            <div class="text-decoration-none text-dark report-item" data-id="${r.Id}">
                                                                <i class="bi bi-file-earmark-text me-1"></i>
                                                                ${r.Name}
                                                            </div>
                                                        </li>
                                                    `).join('')}
                                                </ul>
                                            </div>
                                        </li>
                                    `;
                                }).join('')}
                            </ul>
                        </div>
                    </li>
                `;
            });

            html += `</ul>`;

            $("#projectsHierarchy").html(html);
            bindReportContextMenu("#projectsHierarchy .report-item");
        })
        .fail(function () {
            $("#projectsHierarchy").html('<div class="text-danger">Failed to load projects hierarchy</div>');
        });
    }

    loadProjectsHierarchy();
</script>
