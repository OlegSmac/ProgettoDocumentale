@model ProgettoDocumentale.Application.Requests.Users.DTOs.UserDTO

<div class="modal-content">
    <div class="modal-header">
        <h5 class="modal-title">User info</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
        @Html.AntiForgeryToken()

        <div class="form-horizontal">
            <div class="form-group row mb-2 px-4">
                <div class="col-6 col-md-3">@Html.LabelFor(m => m.UserName, "Username")</div>
                <div class="col-12 col-md-8">
                    @Html.TextBoxFor(m => m.UserName, new { @class = "form-control bg-secondary bg-opacity-25", @readonly = "readonly" })
                </div>
            </div>

            <div class="form-group row mb-2 px-4">
                <div class="col-6 col-md-3">@Html.LabelFor(m => m.Email, "Email")</div>
                <div class="col-12 col-md-8">
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control bg-secondary bg-opacity-25", @readonly = "readonly" })
                </div>
            </div>

            <div class="form-group row mb-2 px-4">
                <div class="col-6 col-md-3">@Html.LabelFor(m => m.Name, "Name")</div>
                <div class="col-12 col-md-8">
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control bg-secondary bg-opacity-25", @readonly = "readonly" })
                </div>
            </div>

            <div class="form-group row mb-2 px-4">
                <div class="col-6 col-md-3">@Html.LabelFor(m => m.Surname, "Surname")</div>
                <div class="col-12 col-md-8">
                    @Html.TextBoxFor(m => m.Surname, new { @class = "form-control bg-secondary bg-opacity-25", @readonly = "readonly" })
                </div>
            </div>

            <div class="form-group row mb-2 px-4">
                <div class="col-6 col-md-3">@Html.LabelFor(m => m.Patronymic, "Patronymic")</div>
                <div class="col-12 col-md-8">
                    @Html.TextBoxFor(m => m.Patronymic, new { @class = "form-control bg-secondary bg-opacity-25", @readonly = "readonly" })
                </div>
            </div>

            <div class="form-group row mb-2 px-4">
                <div class="col-6 col-md-3">@Html.LabelFor(m => m.InstitutionName, "Institution")</div>
                <div class="col-12 col-md-8">
                    @Html.TextBoxFor(m => m.InstitutionName, new { @class = "form-control bg-secondary bg-opacity-25", @readonly = "readonly" })
                </div>
            </div>

            <div class="form-group row mb-2 px-4">
                <div class="col-6 col-md-3">@Html.LabelFor(m => m.Roles, "Roles")</div>
                <div class="col-12 col-md-8">
                    @Html.TextBoxFor(m => m.RolesDisplay, new { @class = "form-control bg-secondary bg-opacity-25", @readonly = "readonly" })
                </div>
            </div>

            <div class="form-group row mb-2 px-4 mt-3">
                <div class="col-6 col-md-3">
                    @Html.LabelFor(m => m.IsEnabled, "Enabled", new { @class = "form-check-label", @for = "IsEnabledSwitch" })
                </div>
                
                <div class="col-12 col-md-8">
                    <div class="form-check form-switch">
                        @Html.CheckBoxFor(m => m.IsEnabled, new
                        {
                            @class = "form-check-input",                            
                            role = "switch",
                            id = "IsEnabledSwitch",
                            disabled = "disabled"
                        })
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>