@model ProgettoDocumentale.Application.Requests.Users.ViewModels.ResetPasswordData

<div class="modal-content" data-success="@(ViewBag.Success == true ? "1" : "0")">
    <div class="modal-header">
        <h5 class="modal-title">Reset password</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    @using (Ajax.BeginForm("ResetPassword", "Admin", new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "handleResetPassword"
    }, new { id = "resetPasswordForm" }))
    {
        <div class="modal-body">
            @Html.AntiForgeryToken()

            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="form-group row mb-2 px-4">
                    <div class="col-6 col-md-4">Username</div>
                    <div class="col-12 col-md-8">
                        @Html.TextBoxFor(m => m.UserName, new { @class = "form-control", @readonly = "readonly" })
                        @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger validation-message", data_valmsg_for = "UserName" })
                    </div>
                </div>

                <div class="form-group row mb-2 px-4">
                    <div class="col-6 col-md-4">Old password</div>
                    <div class="col-12 col-md-8">
                        @Html.PasswordFor(m => m.OldPassword, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.OldPassword, "", new { @class = "text-danger validation-message", data_valmsg_for = "OldPassword" })
                    </div>
                </div>

                <div class="form-group row mb-2 px-4">
                    <div class="col-6 col-md-4">New password</div>
                    <div class="col-12 col-md-8">
                        @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger validation-message", data_valmsg_for = "NewPassword" })
                    </div>
                </div>

                <div id="resetPasswordError"
                     class="alert alert-danger d-none">
                </div>

            </div>
        </div>

        <div class="modal-footer">
            <button type="submit" class="btn btn-primary">Save</button>
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        </div>
    }
</div>
