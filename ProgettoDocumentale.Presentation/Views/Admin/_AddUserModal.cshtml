@model ProgettoDocumentale.Application.Requests.Users.ViewModels.CreateUserRequestData


<div class="modal-content" data-success="@(ViewBag.Success == true ? "1" : "0")">
    <div class="modal-header">
        <h5 class="modal-title">Create a new user</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    @using (Ajax.BeginForm("AddUser", "Admin", new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "handleCreateUpdateUser"
    }, new { id = "userForm" }))
    {
        <div class="modal-body">
            @Html.AntiForgeryToken()

            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="form-group row mb-2 px-4">
                    <div class="col-6 col-md-3">@Html.LabelFor(m => m.UserName, "User name")</div>
                    <div class="col-12 col-md-8">
                        @Html.TextBoxFor(m => m.UserName, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger validation-message", data_valmsg_for = "UserName" })
                    </div>
                </div>

                <div class="form-group row mb-2 px-4">
                    <div class="col-6 col-md-3">@Html.LabelFor(m => m.Password, "Password")</div>
                    <div class="col-12 col-md-8">
                        @Html.TextBoxFor(m => m.Password, new { @class = "form-control", type = "password" })
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger validation-message", data_valmsg_for = "Password" })
                    </div>
                </div>

                <div class="form-group row mb-2 px-4">
                    <div class="col-6 col-md-3">@Html.LabelFor(m => m.Email, "Email")</div>
                    <div class="col-12 col-md-8">
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger validation-message", data_valmsg_for = "Email" })
                    </div>
                </div>

                <div class="form-group row mb-2 px-4">
                    <div class="col-6 col-md-3">@Html.LabelFor(m => m.Name, "Name")</div>
                    <div class="col-12 col-md-8">
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger validation-message", data_valmsg_for = "Name" })
                    </div>
                </div>

                <div class="form-group row mb-2 px-4">
                    <div class="col-6 col-md-3">@Html.LabelFor(m => m.Surname, "Surname")</div>
                    <div class="col-12 col-md-8">
                        @Html.TextBoxFor(m => m.Surname, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Surname, "", new { @class = "text-danger validation-message", data_valmsg_for = "Surname" })
                    </div>
                </div>

                <div class="form-group row mb-2 px-4">
                    <div class="col-6 col-md-3">@Html.LabelFor(m => m.Patronymic, "Patronymic")</div>
                    <div class="col-12 col-md-8">
                        @Html.TextBoxFor(m => m.Patronymic, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Patronymic, "", new { @class = "text-danger validation-message", data_valmsg_for = "Patronymic" })
                    </div>
                </div>

                <div class="form-group row mb-2 px-4">
                    <div class="col-6 col-md-3">@Html.LabelFor(m => m.Roles, "Roles")</div>
                    <div class="col-12 col-md-8">
                        @Html.ListBoxFor(m => m.Roles, (IEnumerable<SelectListItem>)ViewBag.AvailableRoles, new { @class = "selectpicker", title = "Select roles" })
                        @Html.ValidationMessageFor(m => m.Roles, "", new { @class = "text-danger validation-message" })
                    </div>
                </div>

                <div class="form-group row mb-2 px-4">
                    <div class="col-6 col-md-3">@Html.LabelFor(m => m.InstitutionId, "Institution")</div>
                    <div class="col-12 col-md-8">
                        @Html.DropDownListFor(m => m.InstitutionId, (SelectList)ViewBag.Institutions, "Select Institution", new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.InstitutionId, "", new { @class = "text-danger validation-message", data_valmsg_for = "InstitutionId" })
                    </div>
                </div>             

            </div>
        </div>

        <div class="modal-footer">
            <button type="submit" class="btn btn-primary">Register</button>
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        </div>
    }
</div>
