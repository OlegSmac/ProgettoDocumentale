@{
    ViewBag.Title = "Admin page";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.8.1/font/bootstrap-icons.min.css" rel="stylesheet">

@section styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/jquery-contextmenu@2.9.2/dist/jquery.contextMenu.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-select@1.14.0-beta3/dist/css/bootstrap-select.min.css" />
}

<div class="container-fluid">
    @Html.AntiForgeryToken()

    <ul class="nav nav-tabs mb-3" id="adminTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active"
                    id="institutions-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#institutionsTab"
                    type="button"
                    role="tab"
                    aria-controls="institutionsTab"
                    aria-selected="false">
                Institutions
            </button>
        </li>

        <li class="nav-item" role="presentation">
            <button class="nav-link"
                    id="users-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#usersTab"
                    type="button"
                    role="tab"
                    aria-controls="usersTab"
                    aria-selected="true">
                Users
            </button>
        </li>
    </ul>

    <div class="tab-content" id="adminTabsContent">

        <div class="tab-pane fade show active"
             id="institutionsTab"
             role="tabpanel"
             aria-labelledby="institutions-tab">

            <table id="InstitutionDatatable" class="table-borderless row-border border-light mt-2 w-100" cellspacing="0">
                <thead style="background-color: #2f3248; color: #ffffff" class="table-light">
                    <tr>
                        <th>Id</th>
                        <th>InstCode</th>
                        <th>Name</th>
                        <th>AdditionalInfo</th>
                    </tr>
                </thead>
            </table>

            <div class="d-flex justify-content-start mt-3">
                <button type="button"
                        class="btn btn-primary"
                        onclick="openModal({ url: '/Admin/AddInstitution', data: 0, target: '#addInstitutionModal', content: '#addInstitutionModalContent' })"
                        data-bs-toggle="modal"
                        data-bs-target="#addInstitutionModal">
                    New Institution
                </button>
            </div>
        </div>

        <div class="tab-pane fade"
             id="usersTab"
             role="tabpanel"
             aria-labelledby="users-tab">

            <table id="UserDatatable" class="table-borderless row-border border-light mt-2 w-100" cellspacing="0">
                <thead style="background-color: #2f3248; color: #ffffff" class="table-light">
                    <tr>
                        <th>Id</th>
                        <th>UserName</th>
                        <th>Email</th>
                        <th>Name</th>
                        <th>Surname</th>
                        <th>Patronymic</th>
                        <th>Institution</th>
                        <th>Roles</th>
                        <th>Enabled</th>
                    </tr>
                </thead>
            </table>

            <div class="d-flex justify-content-start mt-3">
                <button type="button"
                        class="btn btn-primary"
                        onclick="openModal({ url: '/Admin/AddUser', data: 0, target: '#addUserModal', content: '#addUserModalContent' })"
                        data-bs-toggle="modal"
                        data-bs-target="#addUserModal">
                    New User
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addInstitutionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" id="addInstitutionModalContent"></div>
    </div>
</div>

<div class="modal fade" id="updateInstitutionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" id="updateInstitutionModalContent"></div>
    </div>
</div>

<div class="modal fade" id="addUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" id="addUserModalContent"></div>
    </div>
</div>

<div class="modal fade" id="updateUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" id="updateUserModalContent"></div>
    </div>
</div>

<div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" id="resetPasswordModalContent"></div>
    </div>
</div>

<style>
    .dt-center {
        text-align: center;
    }
</style>

@section scripts {
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-contextmenu@2.9.2/dist/jquery.contextMenu.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-contextmenu@2.9.2/dist/jquery.ui.position.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-select@1.14.0-beta3/dist/js/bootstrap-select.min.js"></script>

    <script src="~/Scripts/Modal/OpenModal.js"></script>
    <script src="~/Scripts/Modal/RolesSelection.js"></script>

    <script src="~/Scripts/Institution/HandleCreateUpdateInstitution.js"></script>
    <script src="~/Scripts/Institution/RemoveInstitution.js"></script>

    <script src="~/Scripts/User/HandleCreateUpdateUser.js"></script>

    <script>
        var institutionTable;
        var userTable;

        $(document).ready(function () {
            userTable = initializeUserDataTable();
            institutionTable = initializeInstitutionDataTable();
        });

        function initializeInstitutionDataTable() {
            var table = $('#InstitutionDatatable').DataTable({
                serverSide: true,
                processing: true,
                pageLength: 15,
                order: [[1, 'asc']],
                lengthMenu: [[10, 15, 25, 50, 100], [10, 15, 25, 50, 100]],
                dom: "<'row'<'col-sm-6'l><'col-sm-6'f>>" +
                    "<'row'<'col-sm-12'tr>>" +
                    "<'row'<'col-sm-5'i><'col-sm-7'p>>",
                ajax: {
                    url: "/Admin/InstitutionTable",
                    type: "POST",
                    dataType: "json"
                },
                columns: [
                    { data: "Id", title: "Id", name: "Id", visible: false },
                    { data: "InstCode", title: "InstCode", name: "InstCode", autoWidth: true },
                    { data: "Name", title: "Name", name: "Name", autoWidth: true },
                    { data: "AdditionalInfo", title: "AdditionalInfo", name: "AdditionalInfo", autoWidth: true }
                ],
                pagingType: "full_numbers",
                language: {
                    search: '<i class="bi bi-search"></i>',
                    searchPlaceholder: "Search",
                    paginate: {
                        first: "First",
                        previous: "&laquo;",
                        next: "&raquo;",
                        last: "Last"
                    }
                }
            });

            $('#InstitutionDatatable').contextMenu({
                selector: 'tbody tr',
                trigger: 'right',
                callback: function (key, options) {
                    var row = table.row(options.$trigger);
                    var id = row.data().Id;

                    switch (key) {
                        case 'Update':
                            openModal({ data: id, url: '/Admin/UpdateInstitution', target: '#updateInstitutionModal', content: '#updateInstitutionModalContent' });
                            break;

                        case 'Remove':
                            toggleRemoveInstitution(id);
                            break;
                    }
                },
                items: {
                    "Update": { name: "Update" },
                    "Remove": { name: "Remove" }
                }
            });

            return table;
        }

        function initializeUserDataTable() {
            var table = $('#UserDatatable').DataTable({
                serverSide: true,
                processing: true,
                pageLength: 15,
                order: [[1, 'asc']],
                lengthMenu: [[10, 15, 25, 50, 100], [10, 15, 25, 50, 100]],
                dom: "<'row'<'col-sm-6'l><'col-sm-6'f>>" +
                    "<'row'<'col-sm-12'tr>>" +
                    "<'row'<'col-sm-5'i><'col-sm-7'p>>",
                ajax: {
                    url: "/Admin/UserTable",
                    type: "POST",
                    dataType: "json"
                },
                columns: [
                    { data: "Id", title: "Id", name: "Id", visible: false },

                    { data: "UserName", title: "Username", name: "UserName", autoWidth: true },
                    { data: "Email", title: "Email", name: "Email", autoWidth: true },
                    { data: "Name", title: "Name", name: "Name", autoWidth: true },
                    { data: "Surname", title: "Surname", name: "Surname", autoWidth: true },
                    { data: "Patronymic", title: "Patronymic", name: "Patronymic", autoWidth: true },
                    { data: "InstitutionId", title: "Institution", name: "InstitutionId", autoWidth: true, searchable: false },

                    {
                        data: "Roles",
                        title: "Roles",
                        name: "Roles",
                        orderable: false,
                        searchable: false,
                        autoWidth: true,
                        render: function (data, type) {
                            if (type === "display") return (data || []).join(", ");
                            return data;
                        }
                    },

                    {
                        data: "IsEnabled",
                        title: "Enabled",
                        name: "IsEnabled",
                        searchable: false,
                        autoWidth: true,
                        className: "dt-center",
                        render: function (data, type) {
                            if (type === "display") {
                                return (data === true || data === 'true')
                                    ? '<i class="fas fa-check-circle text-success"></i>'
                                    : '<i class="fas fa-times-circle text-danger"></i>';
                            }
                            return data;
                        }
                    }
                ],
                pagingType: "full_numbers",
                language: {
                    search: '<i class="bi bi-search"></i>',
                    searchPlaceholder: "Search",
                    paginate: {
                        first: "First",
                        previous: "&laquo;",
                        next: "&raquo;",
                        last: "Last"
                    }
                }
            });

            $('#UserDatatable').contextMenu({
                selector: 'tbody tr',
                trigger: 'right',
                callback: function (key, options) {
                    var row = table.row(options.$trigger);
                    var id = row.data().Id;

                    switch (key) {
                        case 'Update':
                            openModal({ data: id, url: '/Admin/UpdateUser', target: '#updateUserModal', content: '#updateUserModalContent' });
                            break;

                        case 'ResetPassword':
                            openModal({ data: id, url: '/Admin/ResetPassword', target: '#resetPasswordModal', content: '#resetPasswordModalContent' });
                            break;
                    }
                },
                items: {
                    "Update": { name: "Update" },
                    "ResetPassword": { name: "Reset Password" }
                }
            });

            return table;
        }

    </script>

}
