@{
    ViewBag.Title = "Admin page";
}

@section styles {
    <link rel="stylesheet" href="~/Content/all.min.css" />
    <link rel="stylesheet" href="~/Content/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/Content/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="~/Content/jquery.contextMenu.min.css" />
    <link rel="stylesheet" href="~/Content/bootstrap-select.min.css" />
}

<div class="container-fluid">
    @Html.AntiForgeryToken()

    <ul class="nav nav-tabs mb-3" id="adminTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active"
                    id="institutions-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#institutionsTab"
                    data-url="@Url.Action("InstitutionsTab", "Admin")"
                    type="button"
                    role="tab"
                    aria-controls="institutionsTab"
                    aria-selected="true">
                Institutions
            </button>
        </li>

        <li class="nav-item" role="presentation">
            <button class="nav-link"
                    id="users-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#usersTab"
                    data-url="@Url.Action("UsersTab", "Admin")"
                    type="button"
                    role="tab"
                    aria-controls="usersTab"
                    aria-selected="false">
                Users
            </button>
        </li>
    </ul>

    <div class="tab-content" id="adminTabsContent">

        <div class="tab-pane fade show active"
             id="institutionsTab"
             role="tabpanel"
             aria-labelledby="institutions-tab">

            <div class="tab-loader p-2" data-loaded="false">
                <div class="text-muted">Loading…</div>
            </div>

        </div>

        <div class="tab-pane fade"
             id="usersTab"
             role="tabpanel"
             aria-labelledby="users-tab">

            <div class="tab-loader p-2" data-loaded="false"></div>

        </div>

    </div>    
</div>

<style>
    .dt-center {
        text-align: center;
    }
</style>

@section scripts {
    <script src="~/Scripts/dataTables.min.js"></script>
    <script src="~/Scripts/jquery.ui.position.min.js"></script>
    <script src="~/Scripts/jquery.contextMenu.min.js"></script>
    <script src="~/Scripts/bootstrap-select.min.js"></script>

    <script src="~/Scripts/Institution/handleCreateUpdateInstitution.js"></script>
    <script src="~/Scripts/Institution/removeInstitution.js"></script>

    <script src="~/Scripts/User/handleCreateUpdateUser.js"></script>
    <script src="~/Scripts/User/handleResetPassword.js"></script>

    <script src="~/Scripts/Modal/openModal.js"></script>
    <script src="~/Scripts/Modal/rolesSelection.js"></script>

    <script>
        function loadTab(btn) {
            var url = btn.getAttribute("data-url");
            var target = btn.getAttribute("data-bs-target");
            if (!url || !target) return;

            var $loader = $(target).find(".tab-loader");
            $loader.html('<div class="text-muted">Loading…</div>');
            $loader.load(url);
        }

        $(function () {
            var activeBtn = document.querySelector('#adminTabs .nav-link.active');
            if (activeBtn) loadTab(activeBtn);
        });

        document.getElementById('adminTabs')
            .addEventListener('shown.bs.tab', function (event) {
                loadTab(event.target);
            });

    </script>
    
}
