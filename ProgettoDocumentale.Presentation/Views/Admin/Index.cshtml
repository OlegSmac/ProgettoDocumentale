@{
    ViewBag.Title = "Admin page";
}

@section styles {
    <link rel="stylesheet" href="~/Content/all.min.css" />
    <link rel="stylesheet" href="~/Content/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/Content/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="~/Content/jquery.contextMenu.min.css" />
    <link rel="stylesheet" href="~/Content/bootstrap-select.min.css" />
}

<div class="container-fluid">
    @Html.AntiForgeryToken()

    <ul class="nav nav-tabs mb-3" id="adminTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active"
                    id="institutions-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#institutionsTab"
                    type="button"
                    role="tab"
                    aria-controls="institutionsTab"
                    aria-selected="false">
                Institutions
            </button>
        </li>

        <li class="nav-item" role="presentation">
            <button class="nav-link"
                    id="users-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#usersTab"
                    type="button"
                    role="tab"
                    aria-controls="usersTab"
                    aria-selected="true">
                Users
            </button>
        </li>
    </ul>

    <div class="tab-content" id="adminTabsContent">

        <div class="tab-pane fade show active"
             id="institutionsTab"
             role="tabpanel"
             aria-labelledby="institutions-tab">

            <table id="InstitutionsDatatable" class="table-borderless row-border border-light mt-2 w-100" cellspacing="0">
                <thead style="background-color: #2f3248; color: #ffffff" class="table-light">
                    <tr>
                        <th>Id</th>
                        <th>InstCode</th>
                        <th>Name</th>
                        <th>AdditionalInfo</th>
                    </tr>
                </thead>
            </table>

            <div class="d-flex justify-content-start mt-3">
                <button type="button"
                        class="btn btn-primary"
                        onclick="openModal({ url: '/Admin/GetAddInstitution', data: 0, target: '#addInstitutionModal', content: '#addInstitutionModalContent' })"
                        data-bs-toggle="modal"
                        data-bs-target="#addInstitutionModal">
                    New Institution
                </button>
            </div>
        </div>

        <div class="tab-pane fade"
             id="usersTab"
             role="tabpanel"
             aria-labelledby="users-tab">

            <table id="UsersDatatable" class="table-borderless row-border border-light mt-2 w-100" cellspacing="0">
                <thead style="background-color: #2f3248; color: #ffffff" class="table-light">
                    <tr>
                        <th>UserName</th>
                        <th>Email</th>
                        <th>Institution</th>
                        <th>Roles</th>
                        <th>Enabled</th>
                    </tr>
                </thead>
            </table>

            <div class="d-flex justify-content-start mt-3">
                <button type="button"
                        class="btn btn-primary"
                        onclick="openModal({ url: '/Admin/GetAddUser', data: 0, target: '#addUserModal', content: '#addUserModalContent' })"
                        data-bs-toggle="modal"
                        data-bs-target="#addUserModal">
                    New User
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addInstitutionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-body" id="addInstitutionModalContent"></div>
    </div>
</div>

<div class="modal fade" id="updateInstitutionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-body" id="updateInstitutionModalContent"></div>
    </div>
</div>

<div class="modal fade" id="addUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-body" id="addUserModalContent"></div>
    </div>
</div>

<div class="modal fade" id="detailsUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-body" id="detailsUserModalContent"></div>
    </div>
</div>

<div class="modal fade" id="updateUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-body" id="updateUserModalContent"></div>
    </div>
</div>

<div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-body" id="resetPasswordModalContent"></div>
    </div>
</div>

<style>
    .dt-center {
        text-align: center;
    }
</style>

@section scripts {
    <script src="~/Scripts/dataTables.min.js"></script>
    <script src="~/Scripts/jquery.ui.position.min.js"></script>
    <script src="~/Scripts/jquery.contextMenu.min.js"></script>
    <script src="~/Scripts/bootstrap-select.min.js"></script>

    <script src="~/Scripts/Institution/handleCreateUpdateInstitution.js"></script>
    <script src="~/Scripts/Institution/removeInstitution.js"></script>

    <script src="~/Scripts/User/handleCreateUpdateUser.js"></script>
    <script src="~/Scripts/User/handleResetPassword.js"></script>

    <script src="~/Scripts/Modal/openModal.js"></script>
    <script src="~/Scripts/Modal/rolesSelection.js"></script>

    <script>
        var institutionsTable;
        var usersTable;

        $(document).ready(function () {
            usersTable = initializeUsersDataTable();
            institutionsTable = initializeInstitutionsDataTable();

            $('#UsersDatatable tbody').on('dblclick', 'tr', function () {
                var row = usersTable.row(this);
                if (!row.any()) return;

                var id = row.data().Id;

                openModal({
                    data: id,
                    url: '/Admin/GetUserDetails',
                    target: '#detailsUserModal',
                    content: '#detailsUserModalContent'
                });
            });
        });

        function initializeInstitutionsDataTable() {
            var table = $('#InstitutionsDatatable').DataTable({
                serverSide: true,
                processing: true,
                pageLength: 15,
                order: [[1, 'asc']],
                lengthMenu: [[10, 15, 25, 50, 100], [10, 15, 25, 50, 100]],
                dom: "<'row'<'col-sm-6'l><'col-sm-6'f>>" +
                    "<'row'<'col-sm-12'tr>>" +
                    "<'row'<'col-sm-5'i><'col-sm-7'p>>",
                ajax: {
                    url: "/Admin/InstitutionTable",
                    type: "POST",
                    dataType: "json"
                },
                columns: [
                    { data: "Id", title: "Id", name: "Id", visible: false },
                    { data: "InstCode", title: "Inst Code", name: "InstCode", autoWidth: true },
                    { data: "Name", title: "Name", name: "Name", autoWidth: true },
                    { data: "AdditionalInfo", title: "Additional Info", name: "AdditionalInfo", autoWidth: true }
                ],
                pagingType: "full_numbers",
                language: {
                    search: '<i class="bi bi-search"></i>',
                    searchPlaceholder: "Search",
                    paginate: {
                        first: "First",
                        previous: "&laquo;",
                        next: "&raquo;",
                        last: "Last"
                    }
                }
            });

            $('#InstitutionsDatatable').contextMenu({
                selector: 'tbody tr',
                trigger: 'right',
                callback: function (key, options) {
                    var row = table.row(options.$trigger);
                    var id = row.data().Id;

                    switch (key) {
                        case 'Update':
                            openModal({ data: id, url: '/Admin/GetUpdateInstitution', target: '#updateInstitutionModal', content: '#updateInstitutionModalContent' });
                            break;

                        case 'Remove':
                            toggleRemoveInstitution(id);
                            break;
                    }
                },
                items: {
                    "Update": { name: "Update" },
                    "Remove": { name: "Remove" }
                }
            });

            return table;
        }

        function initializeUsersDataTable() {
            var table = $('#UsersDatatable').DataTable({
                serverSide: true,
                processing: true,
                pageLength: 15,
                order: [[1, 'asc']],
                lengthMenu: [[10, 15, 25, 50, 100], [10, 15, 25, 50, 100]],
                dom: "<'row'<'col-sm-6'l><'col-sm-6'f>>" +
                    "<'row'<'col-sm-12'tr>>" +
                    "<'row'<'col-sm-5'i><'col-sm-7'p>>",
                ajax: {
                    url: "/Admin/UserTable",
                    type: "POST",
                    dataType: "json"
                },
                columns: [
                    { data: "UserName", title: "Username", name: "UserName", autoWidth: true },
                    { data: "Email", title: "Email", name: "Email", autoWidth: true },
                    { data: "InstitutionName", title: "Institution", name: "InstitutionName", autoWidth: true },

                    {
                        data: "Roles",
                        title: "Roles",
                        name: "Roles",
                        orderable: false,
                        searchable: false,
                        autoWidth: true,
                        render: function (data, type) {
                            if (type === "display") return (data || []).join(", ");
                            return data;
                        }
                    },

                    {
                        data: "IsEnabled",
                        title: "Enabled",
                        name: "IsEnabled",
                        searchable: false,
                        autoWidth: true,
                        className: "dt-center",
                        render: function (data, type) {
                            if (type === "display") {
                                return (data === true || data === 'true')
                                    ? '<i class="fas fa-check-circle text-success"></i>'
                                    : '<i class="fas fa-times-circle text-danger"></i>';
                            }
                            return data;
                        }
                    }
                ],
                pagingType: "full_numbers",
                language: {
                    search: '<i class="bi bi-search"></i>',
                    searchPlaceholder: "Search",
                    paginate: {
                        first: "First",
                        previous: "&laquo;",
                        next: "&raquo;",
                        last: "Last"
                    }
                }
            });

            $('#UsersDatatable').contextMenu({
                selector: 'tbody tr',
                trigger: 'right',
                callback: function (key, options) {
                    var row = table.row(options.$trigger);
                    var id = row.data().Id;

                    switch (key) {
                        case 'Details':
                            openModal({ data: id, url: '/Admin/GetUserDetails', target: '#detailsUserModal', content: '#detailsUserModalContent' });
                            break;

                        case 'Update':
                            openModal({ data: id, url: '/Admin/GetUpdateUser', target: '#updateUserModal', content: '#updateUserModalContent' });
                            break;

                        case 'ResetPassword':
                            openModal({ data: id, url: '/Admin/GetResetPassword', target: '#resetPasswordModal', content: '#resetPasswordModalContent' });
                            break;
                    }
                },
                items: {
                    "Details": { name: "Details" },
                    "Update": { name: "Update" },
                    "ResetPassword": { name: "Reset Password" }
                }
            });

            return table;
        }

    </script>

}
