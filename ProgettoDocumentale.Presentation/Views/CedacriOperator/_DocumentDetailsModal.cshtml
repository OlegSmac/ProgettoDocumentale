@model ProgettoDocumentale.Application.Requests.Documents.DTOs.DocumentDTO

<div>
    <div class="modal-header">
        <h5 class="modal-title">Document info</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
        @Html.AntiForgeryToken()

        <div class="form-horizontal">            
            <div class="form-group row mb-2 px-4">
                <div class="col-6 col-md-3">@Html.LabelFor(m => m.Name, "Document Name")</div>
                <div class="col-12 col-md-8">
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control bg-secondary bg-opacity-25", @readonly = "readonly" })
                </div>
            </div>

            <div class="form-group row mb-2 px-4">
                <div class="col-6 col-md-3">@Html.LabelFor(m => m.InstitutionId, "Institution")</div>
                <div class="col-12 col-md-8">
                    @Html.TextBoxFor(m => m.InstitutionName, new { @class = "form-control bg-secondary bg-opacity-25", @readonly = "readonly" })
                </div>
            </div>

            <div class="form-group row mb-2 px-4">
                <div class="col-6 col-md-3">@Html.LabelFor(m => m.TypeId, "Document Type")</div>
                <div class="col-12 col-md-8">
                    @Html.TextBoxFor(m => m.TypeName, new { @class = "form-control bg-secondary bg-opacity-25", @readonly = "readonly" })
                </div>
            </div>

            <div class="form-group row mb-2 px-4">
                <div class="col-6 col-md-3">@Html.LabelFor(m => m.ProjectId, "Project")</div>
                <div class="col-12 col-md-8">
                    @Html.TextBoxFor(m => m.ProjectName, new { @class = "form-control bg-secondary bg-opacity-25", @readonly = "readonly" })
                </div>
            </div>

            <div class="form-group row mb-2 px-4">
                <div class="col-6 col-md-3">@Html.LabelFor(m => m.UploadDate, "Upload date")</div>
                <div class="col-12 col-md-8">
                    @Html.TextBoxFor(m => m.UploadDate, "{0:yyyy-MM-dd}", new { @class = "form-control bg-secondary bg-opacity-25", @readonly = "readonly" })
                </div>
            </div>

            <div class="form-group row mb-2 px-4">
                <div class="col-6 col-md-3">@Html.LabelFor(m => m.GroupingDate, "Grouping date")</div>
                <div class="col-12 col-md-8">
                    @Html.TextBoxFor(m => m.GroupingDate, "{0:yyyy-MM-dd}", new { @class = "form-control bg-secondary bg-opacity-25", @readonly = "readonly" })
                </div>
            </div>

            <div class="form-group row mb-2 px-4">
                <div class="col-6 col-md-3">@Html.LabelFor(m => m.AdditionalInfo, "Additional info")</div>
                <div class="col-12 col-md-8">
                    @Html.TextAreaFor(m => m.AdditionalInfo, 3, 1, new { @class = "form-control bg-secondary bg-opacity-25", @readonly = "readonly" })
                </div>
            </div>

        </div>

    </div>
</div>