@{
    ViewBag.Title = "Cedacri operator page";
    //Layout = "_Layout.cshtml";
}

@section styles {
    <link rel="stylesheet" href="~/Content/all.min.css" />
    <link rel="stylesheet" href="~/Content/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/Content/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="~/Content/jquery.contextMenu.min.css" />
    <link rel="stylesheet" href="~/Content/bootstrap-select.min.css" />
}

<div class="container-fluid">
    @Html.AntiForgeryToken()

    <ul class="nav nav-tabs mb-3" id="cedacriOperatorTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active"
                    id="documents-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#documentsTab"
                    data-url="@Url.Action("DocumentsTab", "CedacriOperator")"
                    type="button"
                    role="tab"
                    aria-controls="documentsTab"
                    aria-selected="true">
                Documents
            </button>
        </li>

        <li class="nav-item" role="presentation">
            <button class="nav-link"
                    id="projects-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#projectsTab"
                    data-url="@Url.Action("ProjectsTab", "CedacriOperator")"
                    type="button"
                    role="tab"
                    aria-controls="projectsTab"
                    aria-selected="false">
                Projects
            </button>
        </li>
    </ul>

    <div class="tab-content" id="cedacriOperatorTabsContent">

        <div class="tab-pane fade show active"
             id="documentsTab"
             role="tabpanel"
             aria-labelledby="documents-tab">

            <div class="tab-loader p-2">
                <div class="text-muted">Loading…</div>
            </div>

        </div>

        <div class="tab-pane fade"
             id="projectsTab"
             role="tabpanel"
             aria-labelledby="projects-tab">

            <div class="tab-loader p-2"></div>

        </div>

    </div>
</div>

<style>
    .dt-center {
        text-align: center;
    }
</style>

@section scripts {
    <script src="~/Scripts/dataTables.min.js"></script>
    <script src="~/Scripts/jquery.ui.position.min.js"></script>
    <script src="~/Scripts/jquery.contextMenu.min.js"></script>
    <script src="~/Scripts/bootstrap-select.min.js"></script>

    <script src="~/Scripts/Document/loadDocumentsHierarchy.js"></script>
    <script src="~/Scripts/Document/handleCreateUpdateDocument.js"></script>
    <script src="~/scripts/Document/documentForm.js"></script>
    <script src="~/scripts/Document/addDocumentStart.js"></script>
    <script src="~/scripts/Document/updateDocumentStart.js"></script>
    <script src="~/Scripts/Document/removeDocument.js"></script>

    <script src="~/Scripts/Project/loadProjectsHierarchy.js"></script>
    <script src="~/Scripts/Project/handleCreateUpdateProject.js"></script>
    <script src="~/Scripts/Project/removeProject.js"></script>

    <script src="~/Scripts/formatNetDate.js"></script>
    <script src="~/Scripts/Modal/openModal.js"></script>

    <script>
        function loadTab(btn) {
            var url = btn.getAttribute("data-url");
            var target = btn.getAttribute("data-bs-target");
            if (!url || !target) return;

            var $loader = $(target).find(".tab-loader");
            $loader.html('<div class="text-muted">Loading…</div>');
            $loader.load(url);
        }

        $(function () {
            var activeBtn = document.querySelector('#cedacriOperatorTabs .nav-link.active');
            if (activeBtn) loadTab(activeBtn);
        });

        document.getElementById('cedacriOperatorTabs')
            .addEventListener('shown.bs.tab', function (event) {
                loadTab(event.target);
            });

    </script>    
}
