@model ProgettoDocumentale.Application.Requests.Projects.DTOs.ProjectDTO

<div>
    <div class="modal-header">
        <h5 class="modal-title">Project info</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    
    <div class="modal-body">
        @Html.AntiForgeryToken()           

        <div class="form-horizontal">
            <div class="form-group row mb-2 px-4">
                <div class="col-6 col-md-3">@Html.LabelFor(m => m.Name, "Project Name")</div>
                <div class="col-12 col-md-8">
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control bg-secondary bg-opacity-25", @readonly = "readonly" })
                </div>
            </div>

            <div class="form-group row mb-2 px-4">
                <div class="col-6 col-md-3">@Html.LabelFor(m => m.InstitutionId, "Institution")</div>
                <div class="col-12 col-md-8">
                    @Html.TextBoxFor(m => m.InstitutionName, new { @class = "form-control bg-secondary bg-opacity-25", @readonly = "readonly" })                        
                </div>
            </div>

            <div class="form-group row mb-2 px-4">
                <div class="col-6 col-md-3">@Html.LabelFor(m => m.Username, "Created by")</div>
                <div class="col-12 col-md-8">
                    @Html.TextBoxFor(m => m.Username, new { @class = "form-control bg-secondary bg-opacity-25", @readonly = "readonly" })
                </div>
            </div>

            <div class="form-group row mb-2 px-4">
                <div class="col-6 col-md-3">@Html.LabelFor(m => m.DateFrom, "Start date")</div>
                <div class="col-12 col-md-8">
                    @Html.TextBoxFor(m => m.DateFrom, "{0:yyyy-MM-dd}", new { @class = "form-control bg-secondary bg-opacity-25", @readonly = "readonly" })
                </div>
            </div>

            <div class="form-group row mb-2 px-4">
                <div class="col-6 col-md-3">@Html.LabelFor(m => m.DateTill, "End date")</div>
                <div class="col-12 col-md-8">
                    @Html.TextBoxFor(m => m.DateTill, "{0:yyyy-MM-dd}", new { @class = "form-control bg-secondary bg-opacity-25", @readonly = "readonly" })
                </div>
            </div>

            <div class="form-group row mb-2 px-4">
                <div class="col-6 col-md-3">@Html.LabelFor(m => m.AdditionalInfo, "Additional info")</div>
                <div class="col-12 col-md-8">
                    @Html.TextAreaFor(m => m.AdditionalInfo, 3, 1, new { @class = "form-control bg-secondary bg-opacity-25", @readonly = "readonly" })
                </div>
            </div>

            <div class="form-group row mb-2 px-4 mt-3">
                <div class="col-6 col-md-3">
                    @Html.LabelFor(m => m.IsActive, "Active", new { @class = "form-check-label", @for = "IsEnabledSwitch" })
                </div>

                <div class="col-12 col-md-8">
                    <div class="form-check form-switch">
                        @Html.CheckBoxFor(m => m.IsActive, new
                        {
                            @class = "form-check-input",
                            role = "switch",
                            id = "IsActiveSwitch",
                            disabled = "disabled"
                        })
                    </div>
                </div>
            </div>

        </div>
    </div>        
</div>
