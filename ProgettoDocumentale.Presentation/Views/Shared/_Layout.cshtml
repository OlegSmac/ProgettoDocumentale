<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Progetto Documentale</title>

    @Styles.Render("~/Content/css")
    <link rel="stylesheet" href="~/Content/bootstrap-icons.min.css" />

    @Scripts.Render("~/bundles/modernizr")

    @RenderSection("styles", required: false)

    <style>
        .top-banner img {
            height: 60px;
        }
    </style>
</head>
<body>    
    <div class="container">
        <div class="top-banner">
            <img src="~/Content/images/banner.jpg" alt="Progetto Documentale" />
        </div>

        <nav class="navbar navbar-expand-sm navbar-dark bg-dark rounded mt-3">
            <div class="container-fluid">
                @if (!User.Identity.IsAuthenticated) 
                {
                    <div class="navbar-brand">Progetto Documentale</div>
                }                

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto">
                        @if (User.Identity.IsAuthenticated)
                        {
                            if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">@Html.ActionLink("Admin", "Index", "Admin", null, new { @class = "nav-link" })</li>
                            }

                            if (User.IsInRole("CedacriOperator"))
                            {
                                <li class="nav-item">@Html.ActionLink("CedacriOperator", "Index", "CedacriOperator", null, new { @class = "nav-link" })</li>
                            }

                            if (User.IsInRole("BancOperator"))
                            {
                                <li class="nav-item">@Html.ActionLink("BankOperator", "Index", "BankOperator", null, new { @class = "nav-link" })</li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <span class="nav-link">
                                    <i class="bi bi-person-circle"></i>
                                    @User.Identity.Name
                                </span>
                            </li>

                            <li class="nav-item">
                                @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-link nav-link" style="text-decoration:none;">
                                        <i class="bi bi-box-arrow-right"></i>
                                    </button>
                                }
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                @Html.ActionLink("Login", "Login", "Account", null, new { @class = "nav-link" })
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </div>

    <div class="container body-content mt-3">
        @RenderBody()

        <div class="modal fade" id="appModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-body" id="appModalContent"></div>
                </div>
            </div>
        </div>

        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - Progetto Documentale</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    <script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>

    @RenderSection("scripts", required: false)
</body>
</html>
